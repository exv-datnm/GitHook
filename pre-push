#!/bin/bash

# =======================================================
# Majica customer rule
# =======================================================
# 1. Get branch name and STRIP ALL hidden characters (\r, \n, spaces)
RAW_BRANCH=$(git rev-parse --abbrev-ref HEAD)
BRANCH_NAME=$(echo "$RAW_BRANCH" | tr -d '\r\n[:space:]')

# 2. The Regex Pattern
# Explaining the [a-zA-Z0-9_] sections:
# - We use `+` to ensure at least one character exists
# - We allow numbers, letters, underscores, and dashes where appropriate
PATTERN="^(feature|release|hotfix)/[a-zA-Z0-9]+_[0-9]{8}/[a-zA-Z0-9_]+/[a-zA-Z0-9_]+/[a-zA-Z0-9_-]+$"

# 3. Validation using grep -E
if ! echo "$BRANCH_NAME" | grep -Eq "$PATTERN"; then
  echo "Error: Branch name does not match the naming convention."
  echo "Required format: <Branch Type>/<Task Type>_<Release Date>/<Team ID>/<PPIH Redmine Ticket ID>/<Description>"
  echo "Example: feature/mk_20260430/ai/12345678/add-login-form"
  echo "Current: $BRANCH_NAME"
  exit 1
fi
# =======================================================
# =======================================================


# =======================================================
# == CẤU HÌNH WHITELIST (Chỉ cho phép mẫu này)
# =======================================================
# Mẫu regex BẮT BUỘC
# Sẽ khớp:
#   feature/ph1/VTI_sub/123_task
#   feature/phase3/TMA_sub/456_desc

# Block if branch name is empty (e.g., detached HEAD)
if [ -z "$BRANCH_NAME" ]; then
  echo "❌ Error: Could not determine branch name. Commit aborted."
  exit 1
fi

# 2. Define the flexible pattern: feature/ contains at least one segment ending in '_sub'
# Matches: feature/a/b_sub/c, feature/a_sub/b, feature/a/b/c_sub, etc.
ALLOWED_PATTERN="^feature/.*_sub(/|$)"

# 3. Validation and Blocking
if [[ ! "$BRANCH_NAME" =~ $ALLOWED_PATTERN ]]; then
    echo "----------------------------------------------------------------"
    echo "❌ PRE-COMMIT REJECTED!"
    echo "Current branch: $BRANCH_NAME"
    echo "Constraint: Branch must start with 'feature/' and contain a segment ending in '_sub'."
    echo "Valid examples:"
    echo "  - feature/ui/login_sub/task-1"
    echo "  - feature/api/auth/core_sub/fix"
    echo "----------------------------------------------------------------"
    
    # Exit with 1 to abort the commit process
    exit 1
fi

# Exit with 0 to allow the process to continue
exit 0